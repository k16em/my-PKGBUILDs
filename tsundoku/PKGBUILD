# Maintainer: k16em

pkgname=tsundoku-git
_pkgname=tsundoku
pkgver=r5.gf2e0dc2
pkgrel=1
pkgdesc='CLI to manage read-it-later URLs with tags and read state in a local SQLite database'
arch=('x86_64' 'aarch64')
url='https://github.com/k16em/tsundoku'
license=('MPL-2.0')
depends=('glibc')
makedepends=('git' 'go>=1.27')
provides=("${_pkgname}")
conflicts=("${_pkgname}")
source=("${_pkgname}::git+${url}.git")
sha256sums=('SKIP')

pkgver() {
	cd "${srcdir}/${_pkgname}"
	( set -o pipefail
	  git describe --long --abbrev=7 --tags 2>/dev/null \
	    | sed 's/^v//;s/\([^-]*-g\)/r\1/;s/-/./g' \
	  || printf 'r%s.g%s' "$(git rev-list --count HEAD)" "$(git rev-parse --short=7 HEAD)"
	)
}

prepare() {
	cd "${srcdir}/${_pkgname}"
	mkdir -p build
	go mod download -x
}

build() {
	cd "${srcdir}/${_pkgname}"
	export CGO_ENABLED=1
	export CGO_CPPFLAGS="${CPPFLAGS}"
	export CGO_CFLAGS="${CFLAGS}"
	export CGO_CXXFLAGS="${CXXFLAGS}"
	export CGO_LDFLAGS="${LDFLAGS}"
	export GOFLAGS="-buildmode=pie -trimpath -mod=readonly -modcacherw -ldflags=-linkmode=external"
	go build -o build .
}

check() {
	cd "${srcdir}/${_pkgname}"
	export CGO_ENABLED=1
	go test ./...
}

package() {
	cd "${srcdir}/${_pkgname}"

	install -Dm755 "build/${_pkgname}" "${pkgdir}/usr/bin/${_pkgname}"

	install -Dm644 README.md "${pkgdir}/usr/share/doc/${_pkgname}/README.md"
	install -Dm644 LICENSE "${pkgdir}/usr/share/licenses/${_pkgname}/LICENSE"
}
